venv/

# Secrets - NEVER commit
.polygon_key
*.key
.env
.env.*

# Compliance audit trail written by modules/compliance_manager.py into the working directory
compliance_audit.json

# Exports & runtime logs. Anchored: an unanchored `logs/` also hid docs/logs/,
# the folder of implementation records, from git.
exports/
/logs/
/core/logs/
/webapp/logs/
*.log

# Cache (yfinance disk cache, etc.)
data/cache/
*.pkl.tmp

# IDE
.idea/
.vscode/
*.swp
# Research price cache: regenerable, multi-MB, and must stay separate from the
# 13 committed fixture parquets in core/apex_quant/_cache/.
core/apex_quant/_cache_research/

# Generated price cache. The 13 parquets already TRACKED in
# core/apex_quant/_cache/ are committed test fixtures frozen at 2023-12-29
# (tests/test_recommendation_trace.py depends on them) and stay tracked --
# .gitignore does not affect already-tracked files. This rule only stops the
# other ~30 generated files from cluttering `git status`.
core/apex_quant/_cache/*.parquet

# Signal ledger (production track record) - local state, never committed
data/ledger/
data/my_list.sqlite3*
track_record/.publish.lock

# Web app (webapp/): Node, browser-test artifacts and local runtime data
node_modules/
playwright-report/
test-results/
.playwright-mcp/
.pytest_cache/
webapp/data/
!.env.example
*.tsbuildinfo
.regime_history.json
.signal_history.json
.quanta_reqs_hash
*.spec
*.pem
apex_setups_*.csv
apex_setups_*.json
apex_quant_reports/
backtest_reports/
.claude/
.code-review-graph/

