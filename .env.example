# Copy to .env (git-ignored) and fill in what you use. Every key is optional
# except QUANTA_SEC_CONTACT, without which no Picks name can be funded.

# SEC EDGAR asks every client to identify itself. Your email address or website.
QUANTA_SEC_CONTACT=

# Optional data providers. The default path uses Yahoo Finance and needs no key.
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_KEY=

# Serve the web app on another port (default 5500).
# QUANTA_PORT=5500
